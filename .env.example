# ═══════════════════════════════════════════════════════════════════════════
# Hola Amigo · variables de entorno
# Copia a .env.local para desarrollo. En Vercel se cargan con `vercel env add`.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
#
# Todo vive en el schema `holaamigo`, nunca en `public` (ADR 0001). En este
# proyecto ya no compartimos base con Rentmies, y aun así el schema dedicado se
# conserva: es lo que hace que un `.from('leads')` no pueda tocar por accidente
# una tabla ajena el día que la base vuelva a compartirse.
#
# El schema tiene que estar EXPUESTO en la API o PostgREST devuelve
# `Invalid schema: holaamigo` y todo falla con un mensaje que no dice qué
# hacer: Project Settings → API → Exposed schemas.
SUPABASE_URL=https://vbtoqprrmgfhisfcmcpx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# Ruteo de modelos. Opcionales: si no están, se usan los de config/models.ts.
# Acepta lista separada por comas; se intentan en orden.
# MODEL_RESEARCH=gpt-5,gpt-4.1
# MODEL_EXTRACT=gpt-5-mini
# MODEL_ADAPTIVE=gpt-5-mini
# MODEL_DIAGNOSIS=gpt-5
# MODEL_ANGLES=gpt-5-mini
# MODEL_CLASSIFY=gpt-5-nano
# El guion del agente de agendamiento. Se compila UNA vez por cliente y gobierna
# meses de conversaciones: es donde subir el modelo se paga solo.
# MODEL_PLAYBOOK=gpt-5
# Cada turno de WhatsApp, con el contacto esperando. La latencia es la
# funcionalidad: acá un modelo grande se nota en la factura antes que en la tasa.
# MODEL_SETTER=gpt-5-mini
# El comprador sintético del smoke tester. Un turno de dos frases: modelo chico.
# MODEL_COMPRADOR=gpt-5-mini
# Arma y califica las pruebas de línea. Baja frecuencia, salida que el cliente
# lee: acá conviene el modelo bueno.
# MODEL_PRUEBA=gpt-5-mini

# ── Admin ──────────────────────────────────────────────────────────────────
# Contraseña compartida del equipo interno. Genera una larga y aleatoria.
ADMIN_PASSWORD=
# Opcional: secreto para firmar la cookie. Si falta, se deriva del service role.
# ADMIN_SESSION_SECRET=

# ── Cron ───────────────────────────────────────────────────────────────────
# Vercel manda `Authorization: Bearer $CRON_SECRET` al cron. Sin esto la ruta
# de barrido queda abierta a cualquiera.
CRON_SECRET=

# ── Correo transaccional del producto (Resend) ─────────────────────────────
# Solo lo nuestro: el diagnóstico, los avisos. NUNCA campañas de clientes.
# La separación de reputación está explicada en docs/adr/0008-sendgrid.md
RESEND_API_KEY=
EMAIL_FROM=Hola Amigo <hola@holaamigo.co>

# ── Correo de campañas (SendGrid) ──────────────────────────────────────────
# Sin la key el motor corre igual: registra los envíos como no enviados y los
# deja en el log. Útil para desarrollo.
SENDGRID_API_KEY=
# Settings → Mail Settings → Signed Event Webhook. En producción, sin esta
# clave el webhook de eventos rechaza todo: cualquiera podría reportar rebotes
# falsos y meter contactos a la lista de supresión.
SENDGRID_WEBHOOK_PUBLIC_KEY=
# La Inbound Parse no firma nada: la única autenticación posible es un secreto
# en la URL. Configurar el webhook como:
#   https://TU_DOMINIO/api/webhooks/sendgrid/inbound?k=ESTE_VALOR
SENDGRID_INBOUND_SECRET=
# Dominio (o subdominio) apuntado a mx.sendgrid.net con la Inbound Parse.
# Las respuestas de los contactos llegan a un alias acá, no al buzón real del
# cliente. Ver docs/wiki/10-correo-y-bandejas.md
EMAIL_INBOUND_DOMAIN=parse.holaamigo.co

# ── Instantly (fuente de listas, no motor de envío · ADR 0009) ─────────────
# Opcional y global. Cada cliente puede conectar la suya desde la consola, y
# la suya tiene prioridad sobre esta.
INSTANTLY_API_KEY=

# ── Slack (opcional: sin esto las alertas ATTACK solo van al log) ──────────
SLACK_WEBHOOK_URL=

# ── Público ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://holaamigo-devs.vercel.app
# Cal.com para la banda ATTACK y la ruta C.
NEXT_PUBLIC_CALCOM_URL=

# ── WhatsApp Cloud API (cuando se conecte el primer número) ────────────────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Sin estas dos el agente razona igual y el mensaje queda en `messages` con
# estado `queued` y el motivo escrito. No es un fallo silencioso: es el estado
# real de un cliente cuyo número sigue en revisión de Meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Callbell · el smoke tester (ADR 0025) ──────────────────────────────────
# Con esto le escribimos por WhatsApp a la línea que el prospecto publica en su
# sitio, como si fuéramos un cliente, y le contamos qué pasó. Es la única parte
# del diagnóstico que no es una proyección.
#
# Dashboard de Callbell → Settings → API. El número y el channel_uuid NO van
# acá: se editan en /admin/pruebas sin desplegar, porque son datos de operación
# y no secretos (ADR 0014).
#
# Sin esta llave el smoke tester no manda nada y lo dice: el diagnóstico sale
# igual, sin la sección de la prueba.
CALLBELL_API_KEY=

# Callbell no firma sus webhooks, así que la única autenticación posible es un
# secreto en la URL. Configurar el webhook —o la app que reenvía— como:
#   https://TU_DOMINIO/api/webhooks/callbell?k=ESTE_VALOR
# En producción, sin este valor la ruta rechaza todo: un webhook abierto deja
# inyectar respuestas falsas, y una respuesta falsa es un número falso en el
# diagnóstico de un cliente.
CALLBELL_WEBHOOK_SECRET=
