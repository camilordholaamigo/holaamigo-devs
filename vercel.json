{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/sweep",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/dispatch",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cron/destilar",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/capitulo",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/mes",
      "schedule": "0 13 1 * *"
    },
    {
      "path": "/api/cron/cmo",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/datos",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/pruebas",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/gtm-radar-smoke",
      "schedule": "45 11 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/research/stream/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-transform" },
        { "key": "X-Accel-Buffering", "value": "no" }
      ]
    },
    {
      "source": "/api/pruebas/stream/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-transform" },
        { "key": "X-Accel-Buffering", "value": "no" }
      ]
    },
    {
      "source": "/api/agent/build",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-transform" },
        { "key": "X-Accel-Buffering", "value": "no" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
