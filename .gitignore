# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …y este es el opt-in. `.env.example` no tiene un solo secreto: es la lista de
# qué variables existen, para qué sirve cada una y qué pasa si falta. Estaba
# ignorado, así que el archivo vivía solo en la máquina de quien lo escribió y
# el que clonaba el repo no tenía forma de saber qué cargar.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
